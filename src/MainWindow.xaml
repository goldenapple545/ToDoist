<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="ToDoist"
        Width="380" Height="560"
        MinWidth="300" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">
  <Window.Resources>
    <!-- Палитра по умолчанию. ThemeManager перезаписывает эти кисти при смене темы. -->
    <SolidColorBrush x:Key="GlassBrush" Color="#E6FBFBFC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#75757C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14141414"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#2E4F8CC9"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="InputBrush" Color="#8AFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8CC9"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E0483A"/>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Тени текста и иконок ThemeManager кладёт в ресурсы окна сам: в светлой теме
         их нет вовсе (текст держит тинт стекла и сохраняет ClearType), в тёмной —
         чёрная тень, смещённая вниз-вправо. Пока ключа нет, DynamicResource
         оставляет Effect пустым — именно это и нужно светлой теме. -->

    <!-- Стекло: значения по умолчанию, ThemeManager подменяет их при смене темы -->
    <SolidColorBrush x:Key="GlassSheenBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GlassNoiseBrush" Color="Transparent"/>

    <!-- Иконочная кнопка: прозрачный фон, подсветка при наведении -->
    <Style x:Key="GlassIconButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
              <!-- Тень только на глифе: подложка кнопки при наведении остаётся чистой -->
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Effect="{DynamicResource IconShadow}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Кнопка закрытия: красная подсветка -->
    <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Effect="{DynamicResource IconShadow}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Кнопка добавления задачи -->
    <Style x:Key="AddButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <!-- Тень под всей кнопкой: акцентная плашка целиком отделяется от обоев -->
      <Setter Property="Effect" Value="{DynamicResource IconShadow}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.65"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Круглый чекбокс задачи с анимацией галочки -->
    <Style x:Key="TaskCheck" TargetType="CheckBox">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="20" Height="20" Background="Transparent">
              <Border x:Name="Ring" CornerRadius="10" Background="Transparent"
                      Effect="{DynamicResource IconShadow}"
                      BorderThickness="1.4" BorderBrush="{DynamicResource SubtleBrush}"/>
              <Border x:Name="Fill" CornerRadius="10" Opacity="0"
                      Background="{DynamicResource AccentBrush}"/>
              <TextBlock x:Name="Glyph" Text="&#xE73E;" Opacity="0"
                         FontFamily="{DynamicResource IconFont}" FontSize="10"
                         Foreground="{DynamicResource OnAccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.10"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Кнопка удаления задачи (проявляется при наведении на строку) -->
    <Style x:Key="RowDeleteButton" TargetType="Button">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="7" Background="{TemplateBinding Background}">
              <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Effect="{DynamicResource IconShadow}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                <!-- На плотной красной плашке ореол только мутил бы глиф -->
                <Setter TargetName="Glyph" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Поле ввода задачи -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"
                            Effect="{DynamicResource TextShadow}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тонкий скроллбар -->
    <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border CornerRadius="3" Margin="1,2" Background="{DynamicResource DividerBrush}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Слайдер прозрачности -->
    <Style x:Key="GlassSlider" TargetType="Slider">
      <Setter Property="Height" Value="18"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="18" Background="Transparent">
              <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                      Background="{DynamicResource DividerBrush}"/>
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="12" Height="12">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Тонкий индикатор прогресса -->
    <Style x:Key="TopProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border CornerRadius="1.5" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" CornerRadius="1.5" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Текст задачи -->
    <Style x:Key="TaskTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Effect" Value="{DynamicResource TextShadow}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Метка «вчера» / дата у невыполненных задач прошлых дней -->
    <Style x:Key="TaskBadge" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
      <Setter Property="Effect" Value="{DynamicResource TextShadow}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="6,0,0,2"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
  </Window.Resources>

  <!-- Тень окна рисуется в этих 14 px, сам фон окна прозрачный -->
  <Grid x:Name="ShadowHost" Margin="14">
    <Border x:Name="Card"
            CornerRadius="20"
            Background="Transparent"
            BorderThickness="0">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
      </Border.Effect>

      <!-- Слои стекла: размытый фон, тинт, блик, зерно и кромка с преломлением -->
      <Grid x:Name="GlassRoot">
        <Rectangle x:Name="BackdropLayer" Margin="-60" IsHitTestVisible="False" Visibility="Collapsed">
          <Rectangle.Effect>
            <BlurEffect Radius="34" KernelType="Gaussian" RenderingBias="Performance"/>
          </Rectangle.Effect>
        </Rectangle>

        <Rectangle x:Name="TintLayer" Fill="{DynamicResource GlassBrush}" IsHitTestVisible="False"/>
        <Rectangle x:Name="SheenLayer" Fill="{DynamicResource GlassSheenBrush}" IsHitTestVisible="False"/>
        <Rectangle x:Name="NoiseLayer" Fill="{DynamicResource GlassNoiseBrush}"
                   Opacity="0.03" IsHitTestVisible="False"/>

        <Border x:Name="GlassEdge" CornerRadius="20" BorderThickness="1"
                BorderBrush="{DynamicResource GlassEdgeBrush}" IsHitTestVisible="False"/>

      <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка: за неё можно тащить окно -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" MinHeight="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Top" Margin="0,3,8,0">
            <TextBlock x:Name="TitleText" Text="Сегодня" FontSize="15" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Effect="{DynamicResource TextShadow}"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Пусто" FontSize="11" Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"
                       Effect="{DynamicResource TextShadow}"
                       Foreground="{DynamicResource SubtleBrush}"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="PinButton" Style="{StaticResource GlassIconButton}" Content="&#xE718;"/>
            <Button x:Name="ThemeButton" Style="{StaticResource GlassIconButton}" Content="&#xE706;"/>
            <Button x:Name="MinimizeButton" Style="{StaticResource GlassIconButton}" Content="&#xE921;"/>
            <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>

        <!-- Ввод новой задачи -->
        <Grid Grid.Row="1" Margin="0,14,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid>
            <TextBox x:Name="TaskInput" Style="{StaticResource GlassTextBox}" MaxLength="240"/>
            <TextBlock x:Name="InputPlaceholder" Text="Что нужно сделать?"
                       Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Effect="{DynamicResource TextShadow}"
                       Foreground="{DynamicResource SubtleBrush}"/>
          </Grid>

          <Button x:Name="AddButton" Grid.Column="1" Margin="8,0,0,0"
                  Style="{StaticResource AddButton}" Content="&#xE710;"/>
        </Grid>

        <!-- Список задач -->
        <ScrollViewer x:Name="ListScroll" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="0,0,6,0">
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
          </ScrollViewer.Resources>
          <StackPanel x:Name="TaskPanel"/>
        </ScrollViewer>

        <TextBlock x:Name="EmptyText" Grid.Row="2" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" FontSize="12.5" Margin="14,0,14,0"
                   Effect="{DynamicResource TextShadow}"
                   Foreground="{DynamicResource SubtleBrush}"/>

        <!-- Прогресс и нижняя строка -->
        <ProgressBar x:Name="Progress" Grid.Row="3" Margin="0,10,0,0"
                     Style="{StaticResource TopProgress}"/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Slider x:Name="OpacitySlider" Style="{StaticResource GlassSlider}" Width="104"
                  Minimum="0.45" Maximum="1" Value="0.9" IsMoveToPointEnabled="True"
                  VerticalAlignment="Center"/>

          <TextBlock x:Name="FooterText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                     Effect="{DynamicResource TextShadow}"
                     Foreground="{DynamicResource SubtleBrush}"/>
        </Grid>
      </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
